SERVICE_NAME=go-service
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=INFO

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=2m
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=1048576

DATABASE_ENABLED=false
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_HEALTH_TIMEOUT=2s
DATABASE_SHUTDOWN_TIMEOUT=10s

NATS_ENABLED=false
NATS_URL=nats://127.0.0.1:4222
NATS_CONNECT_TIMEOUT=2s
NATS_RECONNECT_WAIT=2s
NATS_MAX_RECONNECTS=30
NATS_DRAIN_TIMEOUT=15s
NATS_REQUEST_TIMEOUT=5s
NATS_STREAM=APP_EVENTS
NATS_SUBJECTS=app.events.>
NATS_STREAM_MAX_CONSUMERS=16
NATS_STREAM_MAX_MESSAGES=100000
NATS_STREAM_MAX_BYTES=1073741824
NATS_STREAM_MAX_AGE=168h
NATS_STREAM_MAX_MESSAGE_SIZE=1048576
NATS_DUPLICATE_WINDOW=2m
NATS_DURABLE=app-worker
NATS_FILTER_SUBJECT=app.events.work
NATS_QUARANTINE_SUBJECT=app.events.quarantine
NATS_ACK_WAIT=40s
NATS_PROCESS_ATTEMPTS=3
NATS_QUARANTINE_ATTEMPTS=2
NATS_MAX_ACK_PENDING=128
NATS_RETRY_DELAY=5s
NATS_HANDLER_TIMEOUT=30s
NATS_ACK_TIMEOUT=5s
NATS_PULL_EXPIRY=5s


OUTBOX_ENABLED=false
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE=30s
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=1m
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_SETTLEMENT_TIMEOUT=2s
OUTBOX_SHUTDOWN_TIMEOUT=10s

TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
TELEMETRY_EXPORT_TIMEOUT=15s
TELEMETRY_RETRY_INITIAL_INTERVAL=500ms
TELEMETRY_RETRY_MAX_INTERVAL=2s
TELEMETRY_RETRY_MAX_ELAPSED_TIME=10s
TELEMETRY_METRIC_INTERVAL=30s
TELEMETRY_TRACE_SAMPLE_RATIO=1.0
TELEMETRY_TRACE_MAX_QUEUE_SIZE=2048
TELEMETRY_TRACE_MAX_EXPORT_BATCH_SIZE=512
TELEMETRY_TRACE_BATCH_TIMEOUT=5s
TELEMETRY_MAX_EXPORT_REQUEST_BYTES=4194304
TELEMETRY_SHUTDOWN_TIMEOUT=10s
